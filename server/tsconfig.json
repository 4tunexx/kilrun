{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
    "include": ["src/**/*.ts", "../shared/sim-constants.ts", "../shared/moving-platform.ts", "../shared/platform-spatial.ts", "../shared/obstacle-hit.ts", "../shared/plugin-source.ts", "../shared/kill-feed.ts"]
}
