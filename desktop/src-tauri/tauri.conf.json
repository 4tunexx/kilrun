{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kilrun Engine",
  "identifier": "com.kilrun.engine",
  "build": {
    "beforeDevCommand": {
      "script": "npm run engine:ui:dev",
      "cwd": "../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run engine:ui:build",
      "cwd": "../.."
    },
    "beforeBundleCommand": {
      "script": "node desktop/scripts/stamp-exe-icon.mjs",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://kilrun.vercel.app http://localhost:3000 http://127.0.0.1:3000 http://localhost:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Kilrun Engine",
        "width": 1680,
        "height": 1020,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "devtools": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --enable-gpu-rasterization --enable-zero-copy --use-angle=d3d11"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kilrun-engine"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kilrun",
    "copyright": "Kilrun",
    "category": "DeveloperTool",
    "shortDescription": "Kilrun Engine",
    "longDescription": "Windows map editor for Kilrun. Create maps, play-test, and push them to the live game.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "startMenuFolder": "Kilrun",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
