generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // Vercel serverless runs Amazon Linux (rhel) with OpenSSL 3.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Account privilege: player | vip | moderator | admin
model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  steamId     String   @unique
  username    String
  avatarUrl   String
  vpCurrency  Int      @default(0)
  xpProgress  Int      @default(0)
  /// Killrun Points — competitive Elo-style rating (Faceit / ESEA style).
  /// Profile `currentRank` is derived from KP via getRankForKp().
  kp          Int      @default(1000)
  currentRank String   @default("Unranked")
  /// Highest KP ever reached in Ranked Competitive (never decreases).
  peakKp      Int      @default(1000)
  /// Highest KP rank tier ever reached (e.g. Gold) — kept after Premium expires.
  peakRank    String   @default("Unranked")
  role        String   @default("player")
  bio         String   @default("")
  /// ISO 3166-1 alpha-2 country code (e.g. "us", "gb") for public flag.
  countryCode String   @default("")
  notifyPush  Boolean  @default(true)
  notifyEmail Boolean  @default(true)
  isBanned    Boolean  @default(false)
  /// Platform VIP — permanent hub perks (crown, orange name, VIP cosmetics).
  isVip       Boolean  @default(false)
  /// When Kilrun Premium (Ranked Competitive) expires. Independent of isVip.
  premiumExpiresAt DateTime?
  isMuted     Boolean  @default(false)
  createdAt   DateTime @default(now())

  clerkId       String?  @unique
  email         String?  @unique
  emailVerified Boolean  @default(false)

  /// Net community reputation (+rep / -rep from other players).
  reputation Int @default(0)

  /// Consecutive-day login streak, used for "daily login" style requirements.
  loginStreak  Int       @default(0)
  lastLoginAt  DateTime?
  /// Last hub presence heartbeat (online = seen within ~2 minutes).
  lastSeenAt   DateTime?
  /// Last time the player opened the hub leaderboard (daily mission).
  lastLeaderboardAt DateTime?

  /// Lifetime cosmetics actions for achievement / mission metrics.
  cosmeticEquipCount  Int @default(0)
  cosmeticDeleteCount Int @default(0)
  cosmeticResellCount Int @default(0)

  /// Admin/custom requirement counters (metric key → count). Used by custom requirement types.
  customMetrics Json?

  /// Denormalized snapshot of the equipped profile banner cosmetic, copied
  /// from the owned InventoryItem at equip time so rendering the profile
  /// header never needs an extra lookup.
  equippedBannerItemName  String?
  equippedBannerImageUrl  String?
  equippedBannerConfig    Json?

  /// Equipped avatar frame cosmetic (style/color JSON snapshot).
  equippedFrameItemName String?
  equippedFrameConfig   Json?

  /// Equipped nickname effect cosmetic (effect style JSON snapshot).
  equippedNicknameItemName String?
  equippedNicknameConfig   Json?

  /// Equipped body skins from Model Editor (Record<slot, skinConfig>).
  equippedSkins Json?

  /// Optional display status line shown on public profile.
  statusMessage String @default("")

  /// When true, the public profile page hides details from other players.
  profilePrivate Boolean @default(false)
  /// When false, other players cannot leave comments on the public profile.
  profileCommentsEnabled Boolean @default(true)

  /// Profile "showcase" slots + layout for the mini hover-card. Stored as
  /// either a legacy JSON array of { slot, itemType, refId }, or
  /// { entries: [...], layout: { position, align } }.
  showcaseItems Json?

  /// IN-GAME level/XP — earned from kills/wins in matches, upgrades powers
  /// via the in-game menu (press M). Completely separate from `xpProgress`
  /// (the website account level). Do NOT confuse the two.
  gameXp          Int   @default(0)
  /// Unspent Skill Points available to upgrade powers.
  gameSkillPoints Int   @default(0)
  /// Map of AbilityKey -> level (0..10). See shared/ability-progression.ts.
  gameAbilities   Json?

  matchStats         MatchStat[]
  activeMissions     ActiveMission[]
  matchResults       MatchResult[]
  sentMessages       Message[]       @relation("SentMessages")
  receivedMessages   Message[]       @relation("ReceivedMessages")
  forumPosts         ForumPost[]
  forumReplies       ForumReply[]
  supportTickets     SupportTicket[]
  notifications      Notification[]
  friendshipsA       Friendship[]    @relation("FriendshipA")
  friendshipsB       Friendship[]    @relation("FriendshipB")
  purchases          Purchase[]
  userAchievements   UserAchievement[]
  userBadges         UserBadge[]
  globalChatMessages GlobalChatMessage[]
  inventoryItems     InventoryItem[]
  reputationGiven    ReputationVote[] @relation("ReputationVotesGiven")
  reputationReceived ReputationVote[] @relation("ReputationVotesReceived")
  profileCommentsReceived ProfileComment[] @relation("ProfileCommentsReceived")
  profileCommentsAuthored ProfileComment[] @relation("ProfileCommentsAuthored")
}

model MatchStat {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  score          Int
  distance       Int
  livesRemaining Int
  datePlayed     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model MatchResult {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  mode     String
  role     String?
  outcome  String
  xpEarned Int
  vpEarned Int
  /// Competitive KP delta applied for this match (can be negative).
  kpDelta  Int      @default(0)
  /// Extra mode stats (waves cleared, kills, rounds won, …) as JSON.
  stats    Json?
  playedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, mode])
}

model StoreItem {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  itemName     String
  itemCategory String
  itemSku      String  @unique
  vpPrice      Int
  imageUrl     String?
  isAvailable  Boolean @default(true)

  /// Which equip slot this cosmetic occupies: banner | frame | nickname | skin_*.
  /// Null for non-equippable items (boosts, emotes, consumables, ...).
  cosmeticSlot String?
  /// Generated banner config (colors, gradient angle, animation style).
  bannerConfig Json?
  /// Frame / nickname / player skin config JSON (see src/lib/cosmetics.ts, player-skins.ts).
  cosmeticConfig Json?

  /// Times purchased — used for "Popular" sort.
  purchaseCount Int @default(0)
  /// Fire sale discount 0–90. 0 = not on sale.
  fireSalePercent Int @default(0)
  /// When the fire sale ends (UTC). Ignored if percent is 0.
  fireSaleEndsAt  DateTime?

  /// How players obtain it: null/'purchase' = buy with VP;
  /// 'event' | 'mission' | 'achievement' | 'badge' = earned, not buyable.
  unlockType String?
  /// For earned unlocks — which event/mission/achievement/badge grants it (shown to players).
  unlockRef String?
  /// Optional event window end (live countdown on shop card + dashboard promo).
  eventEndsAt DateTime?
  /// Feature on the home dashboard with a custom promo banner.
  promoted Boolean?
  /// Dashboard promo banner: { headline?, colors?, angle? } (BannerConfig-compatible).
  promoBanner Json?

  createdAt DateTime @default(now())
}

model MissionTemplate {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         String  @unique
  title       String
  description String
  rewardXp    Int
  targetCount Int
  /// Progression metric key (see requirement-types.ts).
  metric      String
  /// game | website | daily
  category    String  @default("game")
  isActive    Boolean @default(true)
  /// Optional custom icon image uploaded/set in the admin panel.
  iconImageUrl String?
}

model ActiveMission {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String  @db.ObjectId
  templateKey  String  @default("")
  title        String
  description  String
  rewardXp     Int
  targetCount  Int
  currentCount Int     @default(0)
  metric       String  @default("runs")
  /// Copied from MissionTemplate: game | website | daily
  category     String  @default("game")
  /// YYYY-MM-DD for daily missions (resets each calendar day). Empty for main.
  periodKey    String  @default("")
  isCompleted  Boolean @default(false)
  iconImageUrl String?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, templateKey])
  @@index([userId])
  @@index([userId, metric])
  @@index([userId, category, periodKey])
}

model AchievementDefinition {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         String  @unique
  title       String
  description String
  /// game | website
  category    String  @default("game")
  metric      String
  targetCount Int     @default(1)
  xpReward    Int     @default(50)
  icon        String  @default("trophy")
  /// Optional custom icon image uploaded in the admin panel (overrides `icon`).
  iconImageUrl String?
  isActive    Boolean @default(true)

  unlocks UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  achievementId String   @db.ObjectId
  unlockedAt    DateTime @default(now())

  user        User                  @relation(fields: [userId], references: [id])
  achievement AchievementDefinition @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

model BadgeDefinition {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  key         String  @unique
  title       String
  description String
  rarity      String  @default("common")
  icon        String  @default("award")
  /// Optional custom icon image uploaded in the admin panel (overrides `icon`).
  iconImageUrl String?
  /// auto unlock metric or "manual" / "role"
  metric      String  @default("manual")
  targetCount Int     @default(1)
  isActive    Boolean @default(true)

  unlocks UserBadge[]
}

model UserBadge {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  badgeId  String   @db.ObjectId
  earnedAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id])
  badge BadgeDefinition @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
}

model SiteSettings {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  singletonKey       String  @unique @default("default")
  /// Small mark (sidebar / footer) — defaults to /K2.png when empty.
  logoUrl            String  @default("")
  /// Wordmark shown in home hero / landing — defaults to /kilrun.png when empty.
  headerLogoUrl      String  @default("")
  /// JSON: scale, offsetX, offsetY, opacity, effect for the header wordmark.
  headerLogoStyle    String  @default("{\"scale\":1,\"offsetX\":0,\"offsetY\":0,\"opacity\":1,\"effect\":\"none\"}")
  /// Full-page hub chrome background.
  backgroundUrl      String  @default("https://i.postimg.cc/tJgX2XgN/bg.png")
  /// Home hero banner image (parallax).
  homeHeroImage      String  @default("")
  headerTitle        String  @default("Welcome to Kilrun")
  headerSubtitle     String  @default("The ultimate deathrun experience. Compete, conquer, and climb the ranks.")
  landingHeroImage   String  @default("")
  /// JSON array of { src, alt?, title? } for the landing hero carousel.
  landingHeroSlides  String  @default("[]")
  gameDisabled       Boolean @default(false)
  gameDisabledMsg    String  @default("Kilrun is temporarily offline for maintenance. Check back soon.")
  /// When set and in the future (with gameDisabled), show countdown / auto-enable after.
  gameDisabledUntil  DateTime?
  chatEnabled        Boolean @default(true)
  /// JSON: which hub pages are enabled for non-staff players.
  hubPagesJson       String  @default("{}")
  /// JSON: { left: HubPageId[], right: HubPageId[] } live nav placement.
  hubNavJson         String  @default("{}")
  /// JSON: { showHeader, showFooter, showLandingSlider }.
  hubChromeJson      String  @default("{}")
  /// JSON: Premium pricing, offers, free Ranked week — see premium-config.ts.
  premiumConfigJson  String  @default("{}")
  /// JSON: Competitive rank tiers (name, minKp, imageUrl) — see rank-config.ts.
  rankConfigJson     String  @default("{}")
  /// JSON: Hub announcement carousel config (enabled, types, speed, direction, thickness).
  announcementCarouselJson String @default("{}")
  /// JSON: Inventory drawer settings (resell rate, tabs, title) — see inventory-config.ts.
  inventoryConfigJson String @default("{}")
  /// JSON: custom/edited requirement metrics + shop unlock channels — see requirement-catalog.ts.
  requirementCatalogJson String @default("{}")
  /// JSON: admin-tunable match reward tables + XP bonus formula constants — see match-rewards-config.ts.
  matchRewardsConfigJson String @default("{}")
  /// JSON: admin-tunable global TPS camera/crosshair/player-view default — see tps-view-settings.ts.
  /// Empty = use the hardcoded DEFAULT_TPS_VIEW. Never overrides a per-map `tpsView`.
  defaultTpsViewJson String @default("{}")
}

model GlobalChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  body      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Friendship {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userAId   String   @db.ObjectId
  userBId   String   @db.ObjectId
  status    String   @default("pending")
  createdAt DateTime @default(now())

  userA User @relation("FriendshipA", fields: [userAId], references: [id])
  userB User @relation("FriendshipB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String    @db.ObjectId
  receiverId String    @db.ObjectId
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, createdAt])
}

model ForumPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  authorId  String   @db.ObjectId
  title     String
  body      String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User         @relation(fields: [authorId], references: [id])
  replies ForumReply[]

  @@index([createdAt])
}

model ForumReply {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  authorId  String   @db.ObjectId
  body      String
  createdAt DateTime @default(now())

  post   ForumPost @relation(fields: [postId], references: [id])
  author User      @relation(fields: [authorId], references: [id])

  @@index([postId])
}

/// Comments left on a player's public profile page.
model ProfileComment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  profileUserId String   @db.ObjectId
  authorId      String   @db.ObjectId
  body          String
  createdAt     DateTime @default(now())

  profileUser User @relation("ProfileCommentsReceived", fields: [profileUserId], references: [id])
  author      User @relation("ProfileCommentsAuthored", fields: [authorId], references: [id])

  @@index([profileUserId, createdAt])
  @@index([authorId])
}

model SupportTicket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  subject   String
  category  String
  body      String
  status    String   @default("open")
  staffNote String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  body      String
  type      String   @default("info")
  /// Optional idempotency key (e.g. mission:daily_login:2026-07-22).
  dedupeKey String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, dedupeKey])
}

model NewsPost {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  summary        String
  body           String
  /// Optional hero / header image for the news article.
  headerImageUrl String?
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Guide {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  summary   String
  body      String
  category  String   @default("general")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Purchase {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  itemSku   String
  itemName  String
  vpSpent   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// An owned copy of a store item, shown in the player's inventory drawer.
/// Snapshots cosmetic data at acquisition time so later admin edits to the
/// shop catalog don't retroactively change items players already own.
model InventoryItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  itemSku      String
  itemName     String
  itemCategory String
  cosmeticSlot String?
  bannerConfig Json?
  /// Frame / nickname effect config snapshot at purchase time.
  cosmeticConfig Json?
  imageUrl     String?
  /// Original VP price paid; resale refunds a fraction of this.
  vpValue      Int      @default(0)
  isEquipped   Boolean  @default(false)
  /// Player-marked favorite for inventory filtering.
  isFavorite   Boolean  @default(false)
  acquiredAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, cosmeticSlot])
}

/// Master registry of 3D cosmetic models (supplements StoreItem purchase catalog).
model Asset {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Stable key e.g. fullbody_alien_001
  assetId      String   @unique
  name         String
  displayName  String
  /// body | fullbody | hat | hair | glasses | glove | backpack | mustache | outerwear | pants | shoe | eyebrow | other
  category     String
  rarity       String   @default("common")
  price        Int      @default(0)
  currency     String   @default("vp")
  modelPath    String
  texturePath  String   @default("")
  previewUrl   String?
  thumbnailUrl String?
  enabled      Boolean  @default(true)
  hidden       Boolean  @default(false)
  featured     Boolean  @default(false)
  shopVisible  Boolean  @default(false)
  /// skin_hat | skin_fullbody | skin_back | ...
  equipSlot    String
  tags         String[] @default([])
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([shopVisible, enabled])
  @@index([equipSlot])
}

/// Staff moderation / admin action trail.
model AuditLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId        String   @db.ObjectId
  actorUsername  String
  action         String
  targetUserId   String?
  targetUsername String?
  detail         String   @default("")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

/// A single player's +1/-1 reputation vote on another player. Unique per
/// (voter, target) pair so a player can change their vote but not spam it.
model ReputationVote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  voterId   String   @db.ObjectId
  targetId  String   @db.ObjectId
  value     Int
  createdAt DateTime @default(now())

  voter  User @relation("ReputationVotesGiven", fields: [voterId], references: [id])
  target User @relation("ReputationVotesReceived", fields: [targetId], references: [id])

  @@unique([voterId, targetId])
  @@index([targetId])
}

/// Cloud-published match maps (active per mode). Local editor drafts stay in browser storage.
model GameMap {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Browser localStorage map id when published from the editor.
  localId      String?
  name         String
  /// deathrun | horde | competitive
  mode         String
  /// Full MapDocument JSON (compact enough for Mongo; large assets should be URLs).
  documentJson String
  thumbnailUrl String?
  isActive     Boolean  @default(false)
  createdById  String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mode, isActive])
  @@index([localId])
  @@index([updatedAt])
}

/// Staff-shared map editor prefab stamps (multi-entity layouts).
model GamePrefab {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  localId      String?
  name         String
  /// Optional mode tag for filtering; empty = any mode.
  mode         String   @default("")
  /// JSON array of EditorEntity (relative positions).
  entitiesJson String
  thumbnailUrl String?
  createdById  String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
  @@index([localId])
  @@index([mode])
}

/// Personal-best / WR ghost samples for a cloud map (Deathrun race feel).
model MapGhostRun {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  mapId       String
  userId      String   @db.ObjectId
  username    String   @default("")
  finishMs    Int
  /// Compact samples JSON: [{t,x,y,z}] in sim space, t in ms from start.
  samplesJson String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([mapId, userId])
  @@index([mapId, finishMs])
}

/// Data-driven "Power" (in-game ability) definition — replaces the old
/// hardcoded ABILITY_DEFINITIONS object in shared/ability-progression.ts.
/// The original 11 abilities are seeded with isCore=true (see
/// scripts/seed-power-definitions.ts) so they can be tuned but not deleted.
/// See shared/power-definitions.ts for the generic effect-template engine
/// that interprets `costJson` / `effectParamsJson` at runtime (client,
/// Next.js server, and the Colyseus game server all consume the same shape).
model PowerDefinition {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Stable slug used as the key in User.gameAbilities JSON (e.g. "health").
  key         String   @unique
  name        String
  description String
  /// Emoji/icon glyph for compact UI.
  icon        String   @default("✨")
  maxLevel    Int      @default(10)
  /// Flat in-game account level required before ANY skill points can go in.
  unlockLevel Int      @default(1)
  /// Skill-tree gating: JSON array of { key, level } — every listed power
  /// must be at least at `level` before this power can be leveled at all.
  prerequisitesJson String @default("[]")
  /// JSON CostFormula: { type: 'flat', base } | { type: 'ramp', base, step }.
  costJson    String   @default("{\"type\":\"flat\",\"base\":1}")
  /// stat_bonus | timed_buff | burst_effect — see shared/power-definitions.ts.
  effectType  String   @default("stat_bonus")
  /// JSON matching the shape for `effectType` (StatBonusParams / TimedBuffParams / BurstEffectParams).
  effectParamsJson String @default("{\"bonuses\":[]}")
  /// True for the original 11 — deletable=false in the API/editor, only tunable.
  isCore      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isCore])
}

/// Data-driven GLOBAL weapon catalog definition — replaces the hardcoded
/// CATALOG_WEAPONS array in src/lib/weapon-catalog.ts. The original 8 catalog
/// weapons are seeded with isCore=true (see prisma/seed.ts) so they can be
/// tuned but not deleted. Per-map `MapDocument.weaponDef` overrides still
/// layer on top of whatever this table resolves to at runtime (global
/// default -> per-map override -> in-match runtime), same precedence as before.
model WeaponDefinition {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Stable slug matching a CatalogWeaponId string (e.g. "pistol_001").
  key         String   @unique
  label       String
  modelUrl    String
  /// melee | hitscan | cosmetic — see src/lib/weapons.ts WeaponCombatKind.
  kind        String   @default("hitscan")
  /// JSON Partial<WeaponCombatConfig>: damage, range, cooldownMs, fireMode, magSize, reserveAmmo, ...
  combatJson  String   @default("{}")
  /// JSON array of 'horde' | 'competitive' — which shop modes show this weapon.
  modesJson   String   @default("[\"horde\",\"competitive\"]")
  /// Hint for grip attach in the Weapon Editor 3D preview.
  gripHint    String   @default("")
  /// Optional platform requirement (metric from requirement-types) to buy in-match.
  unlockMetric String?
  unlockAmount Int?
  /// True for the original 8 catalog weapons — deletable=false, only tunable, in the editor/API.
  isCore      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([isCore])
}

/// Lightweight Faceit-style party for shared queue (invite code + room sync).
model Party {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Short 6-char invite code.
  code         String   @unique
  leaderId     String
  memberIds    String[]
  /// Intended queue mode: deathrun | horde | competitive | competitive_ranked
  mode         String?
  /// Colyseus room id once the leader has joined — members joinById.
  activeRoomId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([leaderId])
}
